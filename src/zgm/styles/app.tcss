/* btop's default theme (see widgets/theme.py for where each colour comes from).
   Boxes: rounded, each in its own muted colour, brighter while focused;
   titles are set into the top line by widgets/theme.box_title. */
Screen {
    background: #000000;
    color: #cccccc;
    layout: vertical;
}

#view-tabs {
    height: 1;
    background: #000000;
}

#status-line {
    height: 1;
    background: #000000;
    padding: 0 1;
}

/* ---------- Schedule view ---------- */
#task-queue {
    height: 8;
    border: round #556d59;          /* cpu_box */
    border-title-color: #556d59;
    border-subtitle-color: #556d59;
    border-subtitle-align: right;
    padding: 0 1;
    scrollbar-size-horizontal: 1;
}
#task-queue:focus-within, #task-queue:focus {
    border: round #77ca9b;          /* cpu gradient start */
    border-title-color: #77ca9b;
}
#queue-empty {
    color: #606060;
    padding: 1 2;
    width: auto;
}

TaskCard {
    width: 26;
    height: 5;
    margin-right: 1;
    padding: 0 1;
    border: round #303030;          /* div_line */
    background: #000000;
}
TaskCard:hover {
    border: round #606060;
}
TaskCard.-scheduled {
    opacity: 75%;
}
TaskCard.-selected {
    border: round #b54040;          /* hi_fg */
    background: #1c0e0e;
    opacity: 100%;
}
TaskCard.-dragging {
    border: round #77ca9b;
}

#task-details {
    height: 9;
    border: round #6c6c4b;          /* mem_box */
    border-title-color: #6c6c4b;
    padding: 0 1;
}

#gpu-timeline {
    height: 1fr;
    border: round #805252;          /* proc_box */
    border-title-color: #805252;
    border-subtitle-color: #805252;
    border-subtitle-align: right;
}
#cluster-panel {
    height: auto;
    max-height: 9;
    border: round #5c588d;          /* net_box */
    border-title-color: #5c588d;
    padding: 0 1;
    display: none;
}

#gpu-timeline:focus {
    border: round #d45454;          /* process gradient end */
    border-title-color: #d45454;
    border-subtitle-color: #d45454;
}
#time-axis {
    height: 2;
}
#gpu-rows {
    height: 1fr;
    scrollbar-size-vertical: 1;
}
GPURow {
    height: 4;  /* set per row from its tallest card */
}

/* ---------- Configs view ---------- */
#config-main {
    height: 1fr;
}
#config-tree {
    width: 36;                      /* widened to fit its labels (config.py) */
    max-width: 50%;
    border: round #5c588d;          /* net_box */
    border-title-color: #5c588d;
    background: #000000;
}
#config-tree:focus {
    border: round #b0a9de;
    border-title-color: #b0a9de;
}
#config-right {
    width: 1fr;
}
#config-filter {
    height: 3;
}
#config-table {
    height: 1fr;
    border: round #805252;          /* proc_box */
    border-title-color: #805252;
    background: #000000;
}
#config-table:focus {
    border: round #d45454;
    border-title-color: #d45454;
}
#config-preview {
    height: 12;
    border: round #6c6c4b;          /* mem_box */
    border-title-color: #6c6c4b;
    padding: 0 1;
    overflow-y: auto;
}

/* ---------- Settings view ---------- */
#settings-box {
    height: 1fr;
    border: round #5c588d;          /* net_box */
    border-title-color: #b0a9de;
    padding: 1 2;
}
.setting-row {
    height: auto;
    margin-bottom: 1;
}
.setting-line {
    height: 1;
}
.setting-name {
    width: 24;
}
.setting-line TextToggle {
    width: 34;
}
.setting-help {
    height: auto;
}
#settings-note {
    height: auto;
}

/* ---------- panels: focus and full screen (f) ---------- */
#queue-overview {
    height: 1fr;
    border: round #77ca9b;
    border-title-color: #77ca9b;
    border-subtitle-color: #556d59;
    border-subtitle-align: right;
    background: #000000;
    padding: 0 1;
}
#task-details:focus {
    border: round #b4b46c;
    border-title-color: #b4b46c;
}
#task-details.-zoomed {
    height: 1fr;
}
#cluster-panel:focus {
    border: round #b0a9de;
    border-title-color: #b0a9de;
}
#cluster-panel.-zoomed {
    height: 1fr;
    max-height: 100%;
}

/* dialogs: the view stays visible, dimmed, behind them (Screen's own black
   background above would otherwise cover it) */
ModalScreen {
    background: #000000 60%;
}
