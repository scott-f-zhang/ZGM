/* btop-like boxed panels */
Screen {
    background: #0b0f19;
    layout: vertical;
}

#view-tabs {
    height: 1;
    background: #111827;
}

#status-line {
    height: 1;
    background: #111827;
    padding: 0 1;
}

/* ---------- Schedule view ---------- */
#task-queue {
    height: 8;
    border: round #3b82f6;
    border-title-color: #93c5fd;
    border-title-style: bold;
    padding: 0 1;
    scrollbar-size-horizontal: 1;
}
#task-queue:focus-within, #task-queue:focus {
    border: round #60a5fa;
    border-title-color: #f59e0b;
}
#queue-empty {
    color: $text-muted;
    padding: 1 2;
    width: auto;
}

TaskCard {
    width: 26;
    height: 5;
    margin-right: 1;
    padding: 0 1;
    border: round #374151;
    background: #111827;
}
TaskCard:hover {
    border: round #6b7280;
}
TaskCard.-scheduled {
    opacity: 75%;
}
TaskCard.-selected {
    border: heavy #f59e0b;
    background: #1f2937;
    opacity: 100%;
}
TaskCard.-dragging {
    border: heavy #22c55e;
}

#task-details {
    height: 9;
    border: round #8b5cf6;
    border-title-color: #c4b5fd;
    border-title-style: bold;
    padding: 0 1;
}

#gpu-timeline {
    height: 1fr;
    border: round #10b981;
    border-title-color: #6ee7b7;
    border-title-style: bold;
}
#gpu-timeline:focus {
    border: round #34d399;
    border-title-color: #f59e0b;
}
#time-axis {
    height: 2;
}
#gpu-rows {
    height: 1fr;
    scrollbar-size-vertical: 1;
}
GPURow {
    height: 4;  /* set per row from its tallest card */
}

/* ---------- Configs view ---------- */
#config-main {
    height: 1fr;
}
#config-tree {
    width: 36;
    border: round #3b82f6;
    border-title-color: #93c5fd;
    border-title-style: bold;
    background: #0b0f19;
}
#config-tree:focus {
    border: round #60a5fa;
    border-title-color: #f59e0b;
}
#config-right {
    width: 1fr;
}
#config-filter {
    height: 3;
}
#config-table {
    height: 1fr;
    border: round #10b981;
    border-title-color: #6ee7b7;
    border-title-style: bold;
    background: #0b0f19;
}
#config-table:focus {
    border: round #34d399;
    border-title-color: #f59e0b;
}
#config-preview {
    height: 12;
    border: round #8b5cf6;
    border-title-color: #c4b5fd;
    border-title-style: bold;
    padding: 0 1;
    overflow-y: auto;
}
